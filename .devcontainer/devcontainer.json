{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "sceptre-phenix-topologies",
  "build": {
    "dockerfile": "Dockerfile",
    "cacheFrom": [
      "ghcr.io/sandialabs/sceptre-phenix-topologies/devcontainer:latest"
    ]
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false,
      "installDockerBuildx": false,
      "installDockerComposeV2": false
    }
  },
  "remoteUser": "ubuntu",
  "updateRemoteUserUID": true,
  "mounts": [
    "source=sceptre-phenix-topologies-cache-devcontainer,target=/cache,type=volume"
  ],
  "postCreateCommand": "prek install-hooks",
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "timonwong.shellcheck",
        "tamasfe.even-better-toml"
      ]
    }
  }
}
